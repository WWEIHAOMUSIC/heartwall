#!/bin/bash
# =============================================================================
#  年会爱心墙 · 启动脚本（macOS）
#  双击本文件即可启动。窗口不要关，关掉服务就停了。
# =============================================================================

cd "$(dirname "$0")" || exit 1

# 让脚本自身保持可执行（从 U 盘/网盘拷过来时常丢权限）
chmod +x "$0" 2>/dev/null

clear
echo ""
echo "  年会爱心墙"
echo "  ──────────────────────────────────────"
echo ""

# ---------- 检查 Node.js ----------
if ! command -v node >/dev/null 2>&1; then
    echo "  ✗ 没有找到 Node.js，无法启动。"
    echo ""
    echo "  请先安装 Node.js（免费，装一次即可）："
    echo ""
    echo "    1. 打开 https://nodejs.org"
    echo "    2. 点绿色的 LTS 按钮下载"
    echo "    3. 双击安装包，一路「继续」到底"
    echo "    4. 装完关掉这个窗口，重新双击本文件"
    echo ""
    echo "  如果已经装过 Node.js 还是提示这个，"
    echo "  可能是安装后没有重启电脑。"
    echo ""
    read -r -p "  按回车键关闭 …" _
    exit 1
fi

# ---------- 剩下的活都交给 start.js ----------
# （版本检查、选端口、开浏览器都在那里面，三个平台共用一套逻辑）
exec node start.js
